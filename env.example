HOST=127.0.0.1
PORT=4343
APP_MODE=hub

# Hub only: optional display name for this local machine in dashboard
LOCAL_SERVER_NAME=vm1

# Agent only: required token for hub-to-agent calls
# Must be at least 24 chars (recommended: 32+ random chars)
AGENT_API_TOKEN=

# Hub only: optional dedicated secret for encrypting saved remote tokens.
# If empty, APP_SESSION_SECRET is used.
REMOTE_TOKEN_SECRET=

# Hub only: timeout for remote agent requests in ms
REMOTE_SERVER_REQUEST_TIMEOUT_MS=5000

# HTTPS Configuration (optional)
# Leave empty to use HTTP only
HTTPS_ENABLED=false
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Telegram Bot Configuration (optional)
# Set to true to enable Telegram bot integration
TELEGRAM_ENABLED=false
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated list of allowed Telegram user IDs (e.g., 123456789,987654321)
# Find your user ID by messaging @userinfobot on Telegram
TELEGRAM_ALLOWED_USER_IDS=
